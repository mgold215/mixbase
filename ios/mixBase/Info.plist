<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow audio to play in the background (lock screen, other apps) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- App transport security — allow HTTPS connections to our APIs -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>

	<!-- Photo library access for uploading artwork -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>mixBase needs access to your photos to upload artwork for your projects.</string>

	<!-- Add-only access for saving generated visualizers and renders to Photos -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>mixBase saves your generated visualizer videos to your Photos library.</string>

	<!-- Microphone access not needed for v1, but future-proofing -->

	<!-- Export compliance: only standard HTTPS/TLS is used (exempt), so builds
	     don't strand in "Missing Compliance" waiting for a manual answer. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- App display name -->
	<key>CFBundleDisplayName</key>
	<string>mixBase</string>

	<!-- Deep links from the Home Screen widgets (mixbase://player, ...) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.moodmixformat.mixbase</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>mixbase</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
