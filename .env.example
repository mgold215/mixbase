# Supabase (shared mmf-agents project). Use the NEW key types (Settings → API
# Keys) — the legacy JWT anon/service_role keys leaked with the 2026-10-21
# Railway breach and are being retired (docs/security/2026-10-21-railway-breach.md).
NEXT_PUBLIC_SUPABASE_URL=https://mdefkqaawrusoaojstpq.supabase.co
# Publishable key (sb_publishable_...). Optional — the code falls back to it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) — server only, bypasses RLS. Name kept for history.
SUPABASE_SERVICE_ROLE_KEY=
# LEGACY JWT secret. Only needed while Supabase still signs access tokens with
# it (HS256). After rotating to JWT signing keys (Settings → JWT Keys), tokens
# are ES256 and verified against the public JWKS — DELETE this variable then.
# Unset in prod, HS256 tokens fall back to a Supabase getUser() check.
SUPABASE_JWT_SECRET=
# Supabase personal access token (sbp_...) — ACCOUNT-WIDE: it controls every
# project in the account, not just this one. Powers the boot-time schema
# self-heals (src/lib/schema-heal.ts), /api/db-init and the infra panel's DB
# stats; unset, those quietly skip. Revoke + reissue at
# supabase.com/dashboard/account/tokens whenever Railway vars may have leaked.
SUPABASE_MANAGEMENT_TOKEN=
# Password for the public /api/db-init route (x-setup-token header). Unset, the
# route accepts SUPABASE_MANAGEMENT_TOKEN itself as the password — set this.
DB_INIT_SECRET=

# Anthropic (for any Claude features)
ANTHROPIC_API_KEY=

# Replicate (for AI artwork generation)
REPLICATE_API_TOKEN=

# Runway (for AI video generation)
RUNWAY_API_KEY=

# Spotify Web API app credentials (optional — released-catalog import / ISRC
# lookup in the release pipeline). Create an app at developer.spotify.com.
# Without these, catalog import falls back to Deezer's open API automatically.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://8cf205f8b18df9fb0bc1206a5be06865@o4511332445323264.ingest.us.sentry.io/4511332458627072
SENTRY_AUTH_TOKEN=
SENTRY_ORG=moodmixformat
SENTRY_PROJECT=mixbase

# Infra control panel (/api/infra/* — powers the macOS architecture diagram)
# Railway GraphQL API token (account or team token) — create at railway.app -> Account -> Tokens.
# Optional: without it, /api/infra/railway still reports app liveness via /api/health.
RAILWAY_API_TOKEN=
# Railway project to query (defaults to the moodmixformat project id).
RAILWAY_PROJECT_ID=9ff29ad4-39cd-45d5-a0e9-5cbd4ffa2227
# Optional overrides for the environment health probes (defaults shown).
RAILWAY_PROD_URL=https://mixbase-production.up.railway.app
RAILWAY_STAGING_URL=https://mixbase-staging.up.railway.app
# Optional reference quotas for Supabase scaling signals (defaults: free-tier 1GB storage / 0.5GB db).
SUPABASE_STORAGE_LIMIT_BYTES=
SUPABASE_DB_LIMIT_BYTES=
# GitHub Actions CI node: repo is public so reads work token-free; a token only
# raises the API rate limit. A token with `actions:write` is required ONLY for the
# "re-run CI" safe control action. GITHUB_REPO defaults to mgold215/mixbase.
GITHUB_TOKEN=
GITHUB_REPO=mgold215/mixbase
# Sentry node reuses SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT (above).
# SUPABASE_MANAGEMENT_TOKEN (already used by /api/db-init) also unlocks DB size,
# per-bucket bytes, migrations list, and the read-only SQL tool in /api/infra/chat.

# Optional. Comma-separated user UUIDs granted admin access in addition to the
# owner emails hardcoded in src/lib/admin-identity.ts. Leave unset in normal
# operation. Admin access is NEVER decided by profiles.subscription_tier — that
# column is writable by the user it describes (see migration 036).
ADMIN_USER_IDS=
